# Ordo config profile: minimal-local (personal / demo, Chroma, no object storage)
#
# Usage:
#   cp config/profiles/minimal.env .env
#   make init        # fills SECRET_KEY / MARKDOWN_IMAGE_PROXY_SECRET if empty
#   # edit .env: set LLM_API_KEY + INITIAL_ADMIN_* below
#   make up-lite     # or: infra-free host run, see docs
#
# Everything not listed here keeps the default from .env.example.
# Full variable reference: .env.example (sections 01-09).

# --- identity ---
ENV=development
SECRET_KEY=
ALGORITHM=HS256

# --- first owner (required for first startup, weak passwords are refused) ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_PASSWORD_FILE=

# --- model (only required value for a real QA loop; leave empty to boot offline) ---
LLM_API_KEY=
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-32B

# --- lightweight local backends ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo
VECTOR_BACKEND=chroma
CHROMA_PERSIST_PATH=./vector_chroma
MINIO_ENABLED=false
TASK_QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# --- local serving ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
