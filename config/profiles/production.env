# Ordo config profile: production (external PG/Redis/Milvus/S3, TLS-terminated ingress)
#
# Usage:
#   cp config/profiles/production.env .env
#   make init
#   # Fill EVERY empty value below, then: make db-upgrade && make up-prod-web
#
# Startup refuses to boot when production guardrails fail (see
# app/core/config_validation.py). Do not relax them; fix the config instead.
# Full variable reference: .env.example (sections 01-09).

ENV=production
AUTH_MODE=jwt
# >= 32 random chars, managed via secret store. Never commit the real value.
SECRET_KEY=
# Previous key(s) during rotation, comma-separated. Remove when done.
# SECRET_KEY_FALLBACKS=

# First owner via sealed password file (0600), removed after bootstrap.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD_FILE=/run/secrets/ordo_admin_password

# Database / workers: managed externally, migrations run OUTSIDE the API pods.
DATABASE_URL=
ORDO_DB_CREATE_ALL_ON_STARTUP=false
ORDO_DB_RUNTIME_MIGRATIONS_ENABLED=false
REDIS_URL=
RATE_LIMIT_REDIS_ENABLED=true
BACKEND_WORKERS=1
# BACKEND_WORKERS > 1 additionally requires BM25_LAZY_BUILD_ENABLED=true.
BM25_LAZY_BUILD_ENABLED=true

# Tenant source for jwt mode: prefer a claim your gateway injects.
JWT_TENANT_CLAIM=
# TENANT_HEADER_TRUSTED=true   # only if a trusted gateway rewrites the header

# Public entry points (no localhost, no '*').
ALLOWED_HOSTS=
CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# Object storage / images (change both defaults).
MINIO_ENABLED=true
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DOCUMENTS_ENABLED=true

# Models (secret-store backed).
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=
EMBEDDING_API_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# Docs endpoints are off by default in production; enable explicitly if needed.
# API_DOCS_ENABLED=false
# API_OPENAPI_ENABLED=false
