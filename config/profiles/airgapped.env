# Ordo config profile: air-gapped (no external network at build or runtime)
#
# Usage:
#   cp config/profiles/airgapped.env .env
#   make init
#   # Pre-stage on a connected machine: Python wheels, pnpm store, container
#   # images, and the parser model bundle; then transfer offline.
#   make up-lite
#
# Rules for this profile:
# - No external LLM/Embedding APIs: point at in-cluster compatible endpoints.
# - No external parsers: only bundled backends (deepdoc/basic/markitdown).
# - No phone-home: pinned registries must be internal mirrors.
# Full variable reference: .env.example (sections 01-09).

ENV=development
SECRET_KEY=
ALGORITHM=HS256

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# In-cluster OpenAI-compatible endpoints (examples only).
LLM_API_KEY=airgapped
LLM_API_BASE=http://ollama.ordo.svc.cluster.local:11434/v1
LLM_MODEL=
# EMBEDDING_PROVIDER: openai_compatible | local | dashscope | ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_BASE=http://ollama.ordo.svc.cluster.local:11434/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo
VECTOR_BACKEND=chroma
CHROMA_PERSIST_PATH=./vector_chroma
MINIO_ENABLED=false
TASK_QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Only bundled parsing backends; every external parser stays off.
DEFAULT_PARSER_BACKEND=deepdoc
MINERU_ENABLED=false
DOCLING_ENABLED=false
MARKER_ENABLED=false
PADDLE_VL_ENABLED=false
OLMOCR_ENABLED=false
MAGIC_PDF_ENABLED=false
QIANFAN_OCR_ENABLED=false
DEEPSEEK_OCR_ENABLED=false
ETL4LLM_ENABLED=false
TEXTIN_ENABLED=false

# Internal mirrors (replace with your allow-listed hosts).
PNPM_REGISTRY=
DOCKER_BUILD_NETWORK=default

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
