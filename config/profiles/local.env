# Ordo config profile: local dev (host backend + Docker infra: PG/Redis/Milvus/MinIO)
#
# Usage:
#   cp config/profiles/local.env .env
#   make init
#   # edit .env: set LLM_API_KEY + INITIAL_ADMIN_* + POSTGRES_PASSWORD
#   make setup-host
#
# Diffs vs minimal.env are marked with '<- local'.
# Full variable reference: .env.example (sections 01-09).

ENV=development
SECRET_KEY=
ALGORITHM=HS256

INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

LLM_API_KEY=
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3-32B

# <- local: Docker infra services (see docker/docker-compose.infra.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ordo
POSTGRES_PASSWORD=
VECTOR_BACKEND=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
TASK_QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
# Set TASK_QUEUE_ENABLED=true and run `make worker` to move jobs out of the API process.
# API_DOCUMENT_BACKGROUND_MAX_CONCURRENCY=2

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000
